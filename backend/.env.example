# Ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
# 설치된 모델과 맞출 것: ollama list
OLLAMA_MODEL=llama3.2:latest
# 학습지 전용 (한국어 권장: qwen2.5:7b, exaone3.5:7.8b 등). 비우면 OLLAMA_MODEL 사용
OLLAMA_STUDY_GUIDE_MODEL=
OLLAMA_TIMEOUT_SECONDS=90
OLLAMA_CONNECT_TIMEOUT_SECONDS=5
OLLAMA_NUM_PREDICT=384
OLLAMA_KEEP_ALIVE=15m
OLLAMA_WARMUP_ON_START=true

# API
RINGO_API_PREFIX=/api/v1
# Vercel 배포 후 본인 URL 추가: https://ringo-xxx.vercel.app
RINGO_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Optional: single-user gate (leave empty to disable)
RINGO_API_TOKEN=

# Reference timezone for parsing (IANA)
RINGO_TIMEZONE=Asia/Seoul

# Motemote timetable (06:00 → next day 05:00) & default block length
TIMETABLE_DAY_START_HOUR=6
TIMETABLE_NEXT_DAY_END_HOUR=5
DEFAULT_EVENT_DURATION_MINUTES=60

# Embeddings & study guides
OLLAMA_EMBED_MODEL=nomic-embed-text
RAG_USE_EMBEDDINGS=true
STUDY_GUIDE_NUM_PREDICT=32768
STUDY_GUIDE_RAG_TOP_K=28
STUDY_GUIDE_MIN_SECTIONS=8
STUDY_GUIDE_FEW_SHOT_COUNT=3
STUDY_GUIDE_FEW_SHOT_MAX_CHARS=12000
STUDY_GUIDE_CHUNK_SIZE=1200
STUDY_GUIDE_CHUNK_OVERLAP=180
STUDY_GUIDE_TIMEOUT_SECONDS=420
STUDY_GUIDE_TEMPERATURE=0.25
STUDY_GUIDE_FEW_SHOT_DIR=data/study_guide_examples
STUDY_GUIDE_STUDENT_PROFILE=서강대학교 대학원에서 전공 수업을 듣는 석사과정 학생입니다.
# 비우면 일정/채팅 제목을 수업명으로 사용 (예: 고성능 딥러닝)
STUDY_GUIDE_COURSE_NAME=

# Local storage (when Supabase off)
TASK_PAGE_STORAGE_DIR=storage/task_pages
CHAT_ATTACHMENT_STORAGE_DIR=storage/chat_attachments
SUPABASE_STORAGE_BUCKET=ringo-attachments

# Supabase (optional — leave empty to use frontend localStorage only)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
